<Window x:Class="EverydayToolkit.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="日用工具箱" Width="1080" Height="740" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="日用工具箱" FontSize="26" FontWeight="Bold"/><TextBlock Text="复制 · 找回 · 整理 · 再次使用" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RecordingButton" Content="开启记录" Click="Recording_Click"/><Button Content="设置" Click="Settings_Click"/></StackPanel>
    </Grid>
    <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="剪贴板">
        <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0"><TextBox x:Name="HistorySearch" ToolTip="搜索历史文字；图片按类型、时间与收藏筛选" TextChanged="HistoryFilter_Changed" AutomationProperties.Name="搜索历史文字"/><TextBlock Text="搜索历史文字…" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <ComboBox Grid.Column="1" x:Name="KindFilter" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed"><ComboBoxItem Content="全部内容"/><ComboBoxItem Content="文字"/><ComboBoxItem Content="图片"/></ComboBox>
            <ComboBox Grid.Column="2" x:Name="TimeFilter" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed"><ComboBoxItem Content="所有时间"/><ComboBoxItem Content="最近 24 小时"/><ComboBoxItem Content="最近 7 天"/></ComboBox>
            <CheckBox Grid.Column="3" x:Name="FavoritesFilter" Content="仅收藏" Checked="HistoryFilter_Changed" Unchecked="HistoryFilter_Changed"/>
          </Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="6"><Grid><ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="52" Height="52" Margin="0,0,12,0" Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" Loaded="HistoryThumbnail_Loaded" Unloaded="HistoryThumbnail_Unloaded"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="HistoryEmpty" Text="这里会保存你之后复制的文字和图片。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PreviewTitle" Text="内容预览" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/><Grid Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0"/><Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/></Grid><WrapPanel Grid.Row="2"><Button x:Name="HistoryCopyButton" Content="复制" Style="{StaticResource PrimaryButton}" Click="HistoryCopy_Click"/><Button x:Name="HistoryPasteButton" Content="粘贴到原窗口" Click="HistoryPaste_Click"/><Button x:Name="FavoriteButton" Content="收藏" Click="Favorite_Click"/><Button x:Name="ImageOpenButton" Content="完整预览" Click="ImageOpen_Click"/><Button x:Name="ImageSaveButton" Content="另存 PNG" Click="ImageSave_Click"/><Button x:Name="HistorySnippetButton" Content="保存常用语" Click="HistorySnippet_Click"/><Button x:Name="HistoryCleanButton" Content="文本清洗" Click="HistoryClean_Click"/><Button x:Name="HistoryDeleteButton" Content="删除" Click="HistoryDelete_Click"/></WrapPanel></Grid></Border>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="清空未收藏历史" Click="ClearHistory_Click" DockPanel.Dock="Right" Margin="0"/><TextBlock x:Name="StatisticsText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="常用语"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="新建" Style="{StaticResource PrimaryButton}" Click="NewSnippet_Click"/><Button Content="导入 JSON" Click="ImportSnippets_Click"/><Button Content="导出 JSON" Click="ExportSnippets_Click"/></StackPanel><TextBox x:Name="SnippetSearch" TextChanged="SnippetSearch_Changed" Margin="0,0,14,8" ToolTip="搜索常用语名称、分类与正文" AutomationProperties.Name="搜索常用语"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="6"><ListBox x:Name="SnippetList" SelectionChanged="SnippetList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="SnippetTitle" Text="长期保存的回复与模板" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBox Grid.Row="1" x:Name="SnippetPreview" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Margin="0,0,0,14"/><WrapPanel Grid.Row="2"><Button Content="复制" Style="{StaticResource PrimaryButton}" Click="SnippetCopy_Click"/><Button Content="粘贴到原窗口" Click="SnippetPaste_Click"/><Button Content="编辑" Click="EditSnippet_Click"/><Button Content="文本清洗" Click="SnippetClean_Click"/><Button Content="删除" Click="DeleteSnippet_Click"/></WrapPanel></Grid></Border></Grid></Grid></TabItem>
      <TabItem Header="文本清洗"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="载入剪贴板文字" Click="LoadClipboardText_Click"/><Button Content="去首尾空白" Tag="Trim" Click="TextRule_Click"/><Button Content="去空行" Tag="RemoveBlankLines" Click="TextRule_Click"/><Button Content="行去重" Tag="DeduplicateLines" Click="TextRule_Click"/><Button Content="直接合并断行" Tag="JoinLines" Click="TextRule_Click"/><Button Content="空格合并断行" Tag="JoinWithSpaces" Click="TextRule_Click"/><Button Content="转半角" Tag="ToHalfWidth" Click="TextRule_Click"/><Button Content="转全角" Tag="ToFullWidth" Click="TextRule_Click"/></WrapPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="原文 · 可输入或粘贴" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="OriginalText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="OriginalText_Changed"/></DockPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="结果 · 可继续编辑" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="ResultText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></DockPanel></Border></Grid><WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="复制结果" Style="{StaticResource PrimaryButton}" Click="CopyResult_Click"/><Button Content="粘贴结果到原窗口" Click="PasteResult_Click"/><Button Content="保存为常用语" Click="ResultSnippet_Click"/><Button Content="还原结果" Click="ResetResult_Click"/></WrapPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="正在加载本地内容…" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
</Window>
