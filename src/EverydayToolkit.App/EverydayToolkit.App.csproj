    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EverydayToolkit.App</AssemblyName>
    <RootNamespace>EverydayToolkit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EverydayToolkit.Core\EverydayToolkit.Core.csproj" />
    <ProjectReference Include="..\EverydayToolkit.Windows\EverydayToolkit.Windows.csproj" />
  </ItemGroup>
</Project>
